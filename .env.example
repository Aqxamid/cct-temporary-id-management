# Server
PORT=3000

# Public-facing base URL (used in student upload links sent via email)
PUBLIC_BASE_URL=http://localhost:3000

# Optional public image URL used in email bodies; the banner is also attached to every email
EMAIL_BANNER_URL=

# Session / JWT secret — change this to a long random string in production
JWT_SECRET=change_me_to_a_long_random_string

# SMTP — Gmail example (use an App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@school.edu.ph
SMTP_PASS=your_gmail_app_password

# Email provider: smtp (Gmail) or brevo
EMAIL_PROVIDER=smtp

# Brevo API settings (required when EMAIL_PROVIDER=brevo)
BREVO_API_KEY=your_brevo_api_key
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_SENDER_EMAIL=your_verified_sender@school.edu.ph
BREVO_SENDER_NAME=City College of Tagaytay MIS
# Optional reply-to address and sandbox testing mode
BREVO_REPLY_TO_EMAIL=
BREVO_SANDBOX=false
