# Server
PORT=3000

# Public-facing base URL (used in student upload links sent via email)
PUBLIC_BASE_URL=http://localhost:3000

# Session / JWT secret — change this to a long random string in production
SESSION_SECRET=change_me_to_a_long_random_string

# SMTP — Gmail example (use an App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@school.edu.ph
SMTP_PASS=your_gmail_app_password
