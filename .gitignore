# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Environment / Secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Runtime Data ────────────────────────────────────────────────────────────
# Student database (contains PII — never commit)
data/*

# User uploads
uploads/*

# Generated ID documents
student_temporary_id_doc/*

# Runtime-generated president signatures; keep the source banner and templates tracked
public/images/president_signature.*
!public/images/mis_email_banner.png

# Local tunnel credentials/configuration
.cloudflared/

# Application request logs
logs/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.temp
*.bak

# ─── OS & Editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ─── Puppeteer cache ─────────────────────────────────────────────────────────
.cache/
