# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Environment / Secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Runtime Data ────────────────────────────────────────────────────────────
# SQLite database (contains PII — never commit)
data/*
!data/.gitkeep

# User uploads and generated artifacts (photos, signatures, QR codes, PDFs)
uploads/*

# Runtime-generated president signature; the source banner and ID templates stay tracked
public/images/president_signature.*
!public/images/mis_email_banner.png

# Local tunnel credentials/configuration
.cloudflared/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.temp
*.bak

# ─── OS & Editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ─── Puppeteer cache ─────────────────────────────────────────────────────────
.cache/
